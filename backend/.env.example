APP_ENV=development            # set to "production" in prod (disables AUTH_DISABLED)
CORS_ORIGINS=http://localhost:5173,https://your-frontend-domain
DATABASE=mongo                 # "memory" for local dev/tests only (data lost on restart)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?retryWrites=true
MONGODB_DB=signalforge
FIREBASE_PROJECT_ID=your-project-id
# Firebase Admin credentials come from Application Default Credentials (e.g. GOOGLE_APPLICATION_CREDENTIALS
# pointing to a file kept OUTSIDE the repo, or the host's workload identity). Needed only for account deletion.
ANTHROPIC_API_KEY=your-llm-key
LLM_MODEL=claude-sonnet-5-5
TAVILY_API_KEY=your-search-key
RATE_LIMIT_RUNS_PER_HOUR=10
# Local dev only (ignored when APP_ENV=production):
# AUTH_DISABLED=true
